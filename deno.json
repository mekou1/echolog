{
  "name": "echolog",
  "version": "0.1.0",
  "description": "Minimal structured logging CLI in Deno",
  "license": "MIT",
  "tasks": {
    "dev": "deno run --watch src/main.ts",
    "test": "deno test --coverage=cov",
    "test:unit": "deno test tests/unit/",
    "test:integration": "deno test tests/integration/",
    "test:contract": "deno test tests/contract/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "check": "deno check src/",
    "coverage": "deno coverage cov --lcov > coverage.lcov",
    "coder-gates": "scripts/coder_gates.sh",
    "tester-gates": "scripts/tester_gates.sh",
    "spec-gate": "scripts/spec_gate.sh",
    "integrator-gate": "scripts/integrator_gate.sh"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/cli": "jsr:@std/cli@1",
    "@std/fs": "jsr:@std/fs@1",
    "@std/encoding": "jsr:@std/encoding@1",
    "@std/datetime": "jsr:@std/datetime@1"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true
  },
  "fmt": {
    "options": {
      "useTabs": false,
      "lineWidth": 100,
      "indentWidth": 2,
      "singleQuote": true,
      "proseWrap": "preserve"
    }
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": ["src/", "tests/"],
      "exclude": ["deno.lock", "coverage.lcov"]
    }
  }
}